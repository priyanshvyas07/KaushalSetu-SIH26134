# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=kaushalsetu-sih26134-secret-key-2026

# Centralized AI Provider Configuration
# Supported providers: auto | gemini | groq | openrouter | demo
# If no key is provided, the platform automatically runs in robust Offline Demo Mode.
AI_PROVIDER=auto

# 1. Google Gemini API Key (Optional - for Live Gemini Intelligence)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. OpenRouter API Key (Optional - for OpenRouter Multi-Model routing)
# Obtain at: https://openrouter.ai/
OPENROUTER_API_KEY=

# 3. Groq API Key (Optional - for ultra-low latency Llama-3 inference)
# Obtain at: https://console.groq.com/
GROQ_API_KEY=

# Database Configuration (for Python FastAPI backend_py)
DATABASE_URL=sqlite:///./kaushalsetu.db
SQL_DEBUG=False
